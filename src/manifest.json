{
  "manifest_version": 3,
  "name": "Emoji Tab Title",
  "version": "0.1.0",
  "description": "Prefix the tab title of any site with an emoji of your choice, keeping the site's own icon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "emoji-tab-title@opensource.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "action": {
    "default_title": "Set tab title emoji",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/core.js", "content/content.js"],
      "run_at": "document_start"
    }
  ]
}
